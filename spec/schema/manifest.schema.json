{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aipoch.network/spec/v1/manifest.schema.json",
  "title": "AIPOCH Network v1 snapshot manifest",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "generated_at": {
      "type": "string",
      "format": "utc-date-time"
    },
    "collections": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "href": {
                "type": "string",
                "format": "safe-relative-path"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "href",
              "sha256",
              "bytes"
            ],
            "additionalProperties": true
          },
          "minItems": 0,
          "maxItems": 100000
        },
