{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aipoch.network/spec/v1/catalog.schema.json",
  "title": "AIPOCH Network v1 catalog collections",
  "type": "object",
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_repository"
      },
      "minItems": 0,
      "maxItems": 100000
    },
    "actors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/actor"
      },
      "minItems": 0,
      "maxItems": 100000
    },
    "organizations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/organization"
      },
      "minItems": 0,
      "maxItems": 100000
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      },
      "minItems": 0,
      "maxItems": 100000
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      },
      "minItems": 0,
      "maxItems": 100000
    },
    "collections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/collection"
      },
      "minItems": 0,
      "maxItems": 100000
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      },
      "minItems": 0,
      "maxItems": 100000
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      },
      "minItems": 0,
      "maxItems": 100000
    },
    "tombstones": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tombstone"
      },
      "minItems": 0,
      "maxItems": 100000
    }
  },
  "required": [
    "sources",
    "actors",
    "organizations",
    "projects",
    "resources",
    "collections",
    "relations",
    "claims",
    "tombstones"
  ],
  "additionalProperties": true,
  "$defs": {
    "provenance": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "github",
            "community",
            "maintainer",
            "editor",
            "automatic"
          ]
        },
        "url": {
          "type": "string",
          "format": "safe-https-url",
          "maxLength": 4096
        },
        "observed_at": {
          "type": "string",
          "format": "utc-date-time"
        },
        "review": {
          "type": "string",
          "enum": [
            "pending",
            "reviewed",
            "disputed",
            "stale"
          ]
        },
        "source_id": {
          "type": "string",
          "pattern": "^(?:(?:source|actor):github:[1-9][0-9]*|(?:project|resource|collection|relation|claim):[a-z0-9][a-z0-9._-]{0,127})$"
        },
        "actor_id": {
          "type": "string",
          "pattern": "^(?:(?:source|actor):github:[1-9][0-9]*|(?:project|resource|collection|relation|claim):[a-z0-9][a-z0-9._-]{0,127})$"
        },
        "path": {
          "type": "string",
          "format": "safe-repository-path"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "role",
        "url",
        "observed_at",
        "review"
      ],
      "additionalProperties": true
    },
    "provenance_map": {
      "type": "object",
      "maxProperties": 1000,
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/provenance"
        },
        "minItems": 1,
        "maxItems": 100000
      }
    },
    "source_ref": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^(?:(?:source|actor):github:[1-9][0-9]*|(?:project|resource|collection|relation|claim):[a-z0-9][a-z0-9._-]{0,127})$"
        },
        "role": {
          "type": "string",
          "enum": [
            "primary",
            "documentation",
            "implementation",
            "data",
            "evidence",
            "related"
          ]
        },
        "path": {
          "type": "string",
          "format": "safe-repository-path"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "url": {
          "type": "string",
          "format": "safe-https-url",
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "resolved_at": {
          "type": "string",
          "format": "utc-date-time"
        }
      },
      "required": [
        "source_id",
        "role"
      ],
      "additionalProperties": true
    },
    "alias": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "safe-https-url",
          "maxLength": 4096
        },
        "verified_at": {
          "type": "string",
          "format": "utc-date-time"
        },
        "provider_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "url",
        "verified_at",
        "provider_id"
      ],
      "additionalProperties": true
    },
    "license": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "unknown",
            "identified",
            "conflicting"
          ]
        },
        "spdx_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "url": {
          "type": "string",
          "format": "safe-https-url",
          "maxLength": 4096
        },
        "path": {
          "type": "string",
          "format": "safe-repository-path"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "conditions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": true
    },
    "source_repository": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:(?:source|actor):github:[1-9][0-9]*|(?:project|resource|collection|relation|claim):[a-z0-9][a-z0-9._-]{0,127})$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "status": {
          "type": "string",
          "enum": [
            "candidate",
            "listed"
          ]
        },
        "updated_at": {
          "type": "string",
          "format": "utc-date-time"
        },
        "provenance": {
          "$ref": "#/$defs/provenance_map"
        },
        "kind": {
          "const": "source_repository"
        },
        "provider": {
          "const": "github"
        },
        "provider_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "canonical_url": {
          "type": "string",
          "format": "safe-https-url",
          "maxLength": 4096
        },
        "owner_id": {
          "type": "string",
          "pattern": "^(?:(?:source|actor):github:[1-9][0-9]*|(?:project|resource|collection|relation|claim):[a-z0-9][a-z0-9._-]{0,127})$"
        },
        "default_branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "availability": {
          "type": "string",
          "enum": [
            "accessible",
            "temporarily_unavailable",
            "unknown",
            "private",
            "deleted"
          ]
        },
        "archived": {
          "type": "boolean"
        },
        "observed_at": {
          "type": "string",
          "format": "utc-date-time"
        },
        "stale": {
          "type": "boolean"
        },
        "license": {
          "$ref": "#/$defs/license"
        },
        "aliases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/alias"
          },
          "minItems": 0,
          "maxItems": 100000
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "minItems": 0,
          "maxItems": 100000,
          "uniqueItems": true
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "stars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "homepage": {
          "type": "string",
          "format": "safe-https-url",
          "maxLength": 4096
        },
        "readme": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "latest_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "fork_of": {
          "type": "string",
          "pattern": "^(?:(?:source|actor):github:[1-9][0-9]*|(?:project|resource|collection|relation|claim):[a-z0-9][a-z0-9._-]{0,127})$"
        }
      },
      "required": [
        "kind",
        "id",
        "title",
        "status",
        "updated_at",
        "provenance",
        "provider",
        "provider_id",
        "canonical_url",
        "owner_id",
        "availability",
        "archived",
        "observed_at",
        "stale",
        "license",
        "aliases"
      ],
      "additionalProperties": true
    },
    "actor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:(?:source|actor):github:[1-9][0-9]*|(?:project|resource|collection|relation|claim):[a-z0-9][a-z0-9._-]{0,127})$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "status": {
          "type": "string",
          "enum": [
            "candidate",
            "listed"
          ]
        },
        "updated_at": {
          "type": "string",
          "format": "utc-date-time"
        },
        "provenance": {
          "$ref": "#/$defs/provenance_map"
        },
        "kind": {
          "const": "actor"
        },
        "provider": {
          "const": "github"
        },
        "provider_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "account_type": {
          "type": "string",
          "enum": [
            "user",
            "organization"
          ]
        },
        "login": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "canonical_url": {
          "type": "string",
          "format": "safe-https-url",
          "maxLength": 4096
        },
        "aliases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/alias"
          },
          "minItems": 0,
          "maxItems": 100000
        }
      },
      "required": [
        "kind",
        "id",
        "title",
        "status",
        "updated_at",
        "provenance",
        "provider",
        "provider_id",
        "account_type",
        "login",
        "canonical_url",
        "aliases"
      ],
      "additionalProperties": true
    },
    "organization": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:(?:source|actor):github:[1-9][0-9]*|(?:project|resource|collection|relation|claim):[a-z0-9][a-z0-9._-]{0,127})$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "status": {
          "type": "string",
          "enum": [
            "candidate",
            "listed"
          ]
        },
        "updated_at": {
          "type": "string",
          "format": "utc-date-time"
        },
        "provenance": {
          "$ref": "#/$defs/provenance_map"
        },
        "kind": {
          "const": "organization"
        },
        "actor_id": {
          "type": "string",
          "pattern": "^(?:(?:source|actor):github:[1-9][0-9]*|(?:project|resource|collection|relation|claim):[a-z0-9][a-z0-9._-]{0,127})$"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:(?:source|actor):github:[1-9][0-9]*|(?:project|resource|collection|relation|claim):[a-z0-9][a-z0-9._-]{0,127})$"
          },
          "minItems": 0,
          "maxItems": 100000,
          "uniqueItems": true
        },
        "resource_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:(?:source|actor):github:[1-9][0-9]*|(?:project|resource|collection|relation|claim):[a-z0-9][a-z0-9._-]{0,127})$"
          },
          "minItems": 0,
          "maxItems": 100000,
          "uniqueItems": true
        },
        "participation": {
          "type": "string",
          "enum": [
            "community_indexed",
            "maintainer_acknowledged",
            "actively_curated"
          ]
        }
      },
      "required": [
        "kind",
        "id",
        "title",
        "status",
        "updated_at",
        "provenance",
        "actor_id",
        "source_ids",
        "resource_ids",
        "participation"
      ],
      "additionalProperties": true
    },
    "project": {
      "type": "object",
      "properties": {
