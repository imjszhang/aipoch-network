{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aipoch.network/spec/v1/catalog.schema.json",
  "title": "AIPOCH Network v1 catalog collections",
  "type": "object",
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_repository"
      },
      "minItems": 0,
      "maxItems": 100000
    },
    "actors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/actor"
      },
      "minItems": 0,
      "maxItems": 100000
    },
    "organizations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/organization"
      },
      "minItems": 0,
      "maxItems": 100000
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      },
      "minItems": 0,
      "maxItems": 100000
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      },
      "minItems": 0,
      "maxItems": 100000
    },
    "collections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/collection"
      },
      "minItems": 0,
      "maxItems": 100000
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      },
      "minItems": 0,
      "maxItems": 100000
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      },
      "minItems": 0,
      "maxItems": 100000
    },
    "tombstones": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tombstone"
      },
      "minItems": 0,
      "maxItems": 100000
    }
  },
  "required": [
    "sources",
    "actors",
    "organizations",
    "projects",
    "resources",
    "collections",
    "relations",
    "claims",
    "tombstones"
  ],
  "additionalProperties": true,
  "$defs": {
    "catalog_date": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "format": "utc-date-time"
        },
        "basis": {
          "type": "string",
          "enum": [
            "exact",
            "observed_bound",
            "unknown"
          ]
        },
        "evidence": {
          "type": "string",
          "format": "safe-https-url",
          "maxLength": 4096
        }
      },
      "required": [
        "basis"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "basis": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "value"
              ]
            }
          },
          "else": {
            "required": [
              "value",
              "evidence"
            ]
          }
        }
      ]
    },
    "catalog_dates": {
      "type": "object",
      "properties": {
        "first_published": {
          "$ref": "#/$defs/catalog_date"
        },
        "content_updated": {
          "$ref": "#/$defs/catalog_date"
        }
      },
      "required": [
        "first_published",
        "content_updated"
      ],
      "additionalProperties": true
    },
    "observation": {
      "type": "object",
      "properties": {
        "last_attempt_at": {
          "type": "string",
          "format": "utc-date-time"
        },
        "last_success_at": {
          "type": "string",
          "format": "utc-date-time"
        },
        "result": {
          "type": "string",
          "enum": [
            "ok",
            "unavailable",
            "unsupported",
            "invalid_response"
          ]
        }
      },
      "required": [
        "last_attempt_at",
        "result"
      ],
      "additionalProperties": true
    },
    "metric_observation": {
      "type": "object",
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "observed_at": {
          "type": "string",
          "format": "utc-date-time"
        },
        "last_attempt_at": {
          "type": "string",
          "format": "utc-date-time"
        },
        "result": {
          "type": "string",
          "enum": [
            "ok",
            "unavailable",
            "unsupported",
            "invalid_response"
          ]
        },
        "visibility": {
          "const": "public_api"
        }
      },
      "required": [
        "last_attempt_at",
        "result",
        "visibility"
      ],
      "additionalProperties": true,
      "dependencies": {
        "value": [
          "observed_at"
        ],
        "observed_at": [
          "value"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "const": "ok"
              }
            }
          },
          "then": {
            "required": [
              "value",
              "observed_at"
            ]
          }
        }
      ]
    },
    "source_activity": {
      "type": "object",
      "properties": {
        "default_branch_head": {
          "type": "object",
          "properties": {
            "sha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "committed_at": {
              "type": "string",
              "format": "utc-date-time"
            },
            "observed_at": {
              "type": "string",
              "format": "utc-date-time"
            },
            "date_status": {
              "type": "string",
              "enum": [
                "valid",
                "unknown",
                "invalid",
                "future"
              ]
            }
          },
          "required": [
            "sha",
            "observed_at",
            "date_status"
          ],
          "additionalProperties": true,
          "allOf": [
            {
              "if": {
                "properties": {
                  "date_status": {
                    "const": "valid"
                  }
                }
              },
              "then": {
                "required": [
                  "committed_at"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "committed_at"
                  ]
                }
              }
            }
          ]
        },
        "observation": {
          "$ref": "#/$defs/observation"
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "github",
            "community",
            "maintainer",
            "editor",
            "automatic"
          ]
        },
        "url": {
          "type": "string",
          "format": "safe-https-url",
          "maxLength": 4096
        },
        "observed_at": {
          "type": "string",
          "format": "utc-date-time"
        },
        "review": {
          "type": "string",
          "enum": [
            "pending",
            "reviewed",
            "disputed",
            "stale"
          ]
        },
        "source_id": {
          "type": "string",
          "pattern": "^(?:(?:source|actor):github:[1-9][0-9]*|(?:project|resource|collection|relation|claim):[a-z0-9][a-z0-9._-]{0,127})$"
        },
        "actor_id": {
          "type": "string",
          "pattern": "^(?:(?:source|actor):github:[1-9][0-9]*|(?:project|resource|collection|relation|claim):[a-z0-9][a-z0-9._-]{0,127})$"
        },
        "path": {
          "type": "string",
          "format": "safe-repository-path"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "role",
        "url",
        "observed_at",
        "review"
      ],
      "additionalProperties": true
    },
    "provenance_map": {
      "type": "object",
      "maxProperties": 1000,
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/provenance"
        },
        "minItems": 1,
        "maxItems": 100000
      }
    },
    "source_ref": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^(?:(?:source|actor):github:[1-9][0-9]*|(?:project|resource|collection|relation|claim):[a-z0-9][a-z0-9._-]{0,127})$"
        },
        "role": {
          "type": "string",
          "enum": [
            "primary",
            "documentation",
            "implementation",
            "data",
            "evidence",
            "related"
          ]
        },
        "path": {
          "type": "string",
          "format": "safe-repository-path"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "url": {
          "type": "string",
          "format": "safe-https-url",
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "resolved_at": {
          "type": "string",
          "format": "utc-date-time"
        }
      },
      "required": [
        "source_id",
        "role"
      ],
      "additionalProperties": true
    },
    "alias": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "safe-https-url",
          "maxLength": 4096
        },
        "verified_at": {
          "type": "string",
          "format": "utc-date-time"
        },
        "provider_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "url",
        "verified_at",
        "provider_id"
      ],
      "additionalProperties": true
    },
    "license": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "unknown",
            "identified",
            "conflicting"
          ]
        },
        "spdx_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "url": {
          "type": "string",
          "format": "safe-https-url",
          "maxLength": 4096
        },
        "path": {
          "type": "string",
          "format": "safe-repository-path"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "conditions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": true
    },
    "source_repository": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:(?:source|actor):github:[1-9][0-9]*|(?:project|resource|collection|relation|claim):[a-z0-9][a-z0-9._-]{0,127})$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "status": {
          "type": "string",
          "enum": [
            "candidate",
            "listed"
          ]
        },
        "updated_at": {
          "type": "string",
          "format": "utc-date-time"
        },
        "provenance": {
          "$ref": "#/$defs/provenance_map"
        },
        "catalog_dates": {
          "$ref": "#/$defs/catalog_dates"
        },
        "kind": {
          "const": "source_repository"
        },
        "provider": {
          "const": "github"
        },
        "provider_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "canonical_url": {
          "type": "string",
          "format": "safe-https-url",
          "maxLength": 4096
        },
        "owner_id": {
          "type": "string",
          "pattern": "^(?:(?:source|actor):github:[1-9][0-9]*|(?:project|resource|collection|relation|claim):[a-z0-9][a-z0-9._-]{0,127})$"
        },
        "default_branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "availability": {
          "type": "string",
          "enum": [
            "accessible",
            "temporarily_unavailable",
            "unknown",
            "private",
            "deleted"
          ]
        },
        "archived": {
          "type": "boolean"
        },
        "observed_at": {
          "type": "string",
          "format": "utc-date-time"
        },
        "stale": {
          "type": "boolean"
        },
        "license": {
          "$ref": "#/$defs/license"
        },
        "aliases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/alias"
          },
          "minItems": 0,
          "maxItems": 100000
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "minItems": 0,
          "maxItems": 100000,
          "uniqueItems": true
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "stars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "homepage": {
          "type": "string",
          "format": "safe-https-url",
          "maxLength": 4096
        },
        "collaboration": {
          "type": "object",
          "properties": {
            "issues_url": {
              "type": "string",
              "format": "safe-https-url",
              "maxLength": 4096
            },
            "discussions_url": {
              "type": "string",
              "format": "safe-https-url",
              "maxLength": 4096
            }
          },
          "required": [],
          "additionalProperties": true
        },
        "readme": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "latest_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "fork_of": {
          "type": "string",
          "pattern": "^(?:(?:source|actor):github:[1-9][0-9]*|(?:project|resource|collection|relation|claim):[a-z0-9][a-z0-9._-]{0,127})$"
        },
        "github_metrics": {
          "type": "object",
          "properties": {
            "stars": {
              "$ref": "#/$defs/metric_observation"
            },
            "forks": {
              "$ref": "#/$defs/metric_observation"
            }
          },
          "required": [],
          "additionalProperties": true
        },
        "source_activity": {
          "$ref": "#/$defs/source_activity"
        },
        "observation": {
          "$ref": "#/$defs/observation"
        }
      },
      "required": [
        "kind",
        "id",
        "title",
        "status",
        "updated_at",
        "provenance",
        "provider",
        "provider_id",
        "canonical_url",
        "owner_id",
        "availability",
        "archived",
        "observed_at",
        "stale",
        "license",
        "aliases"
      ],
      "additionalProperties": true
    },
    "actor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:(?:source|actor):github:[1-9][0-9]*|(?:project|resource|collection|relation|claim):[a-z0-9][a-z0-9._-]{0,127})$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "status": {
          "type": "string",
          "enum": [
            "candidate",
            "listed"
          ]
        },
        "updated_at": {
          "type": "string",
          "format": "utc-date-time"
        },
        "provenance": {
          "$ref": "#/$defs/provenance_map"
        },
        "catalog_dates": {
          "$ref": "#/$defs/catalog_dates"
        },
        "kind": {
          "const": "actor"
        },
        "provider": {
          "const": "github"
        },
        "provider_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "account_type": {
          "type": "string",
          "enum": [
            "user",
            "organization"
          ]
        },
        "login": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "canonical_url": {
          "type": "string",
          "format": "safe-https-url",
          "maxLength": 4096
        },
        "aliases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/alias"
          },
          "minItems": 0,
          "maxItems": 100000
        },
        "github_metrics": {
          "type": "object",
          "properties": {
            "followers": {
              "$ref": "#/$defs/metric_observation"
            },
            "following": {
              "$ref": "#/$defs/metric_observation"
            },
            "public_repositories": {
              "$ref": "#/$defs/metric_observation"
            }
          },
          "required": [],
          "additionalProperties": true
        },
        "observation": {
          "$ref": "#/$defs/observation"
        }
      },
      "required": [
        "kind",
        "id",
        "title",
        "status",
        "updated_at",
        "provenance",
        "provider",
        "provider_id",
        "account_type",
        "login",
        "canonical_url",
        "aliases"
      ],
      "additionalProperties": true
    },
    "organization": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:(?:source|actor):github:[1-9][0-9]*|(?:project|resource|collection|relation|claim):[a-z0-9][a-z0-9._-]{0,127})$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "status": {
          "type": "string",
          "enum": [
            "candidate",
            "listed"
          ]
        },
        "updated_at": {
          "type": "string",
          "format": "utc-date-time"
        },
        "provenance": {
          "$ref": "#/$defs/provenance_map"
        },
        "catalog_dates": {
          "$ref": "#/$defs/catalog_dates"
        },
        "kind": {
          "const": "organization"
        },
        "actor_id": {
          "type": "string",
          "pattern": "^(?:(?:source|actor):github:[1-9][0-9]*|(?:project|resource|collection|relation|claim):[a-z0-9][a-z0-9._-]{0,127})$"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:(?:source|actor):github:[1-9][0-9]*|(?:project|resource|collection|relation|claim):[a-z0-9][a-z0-9._-]{0,127})$"
          },
          "minItems": 0,
          "maxItems": 100000,
          "uniqueItems": true
        },
        "resource_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:(?:source|actor):github:[1-9][0-9]*|(?:project|resource|collection|relation|claim):[a-z0-9][a-z0-9._-]{0,127})$"
          },
          "minItems": 0,
          "maxItems": 100000,
          "uniqueItems": true
        },
        "participation": {
          "type": "string",
          "enum": [
            "community_indexed",
            "maintainer_acknowledged",
            "actively_curated"
          ]
        }
      },
      "required": [
        "kind",
        "id",
        "title",
        "status",
        "updated_at",
        "provenance",
        "actor_id",
        "source_ids",
        "resource_ids",
        "participation"
      ],
      "additionalProperties": true
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:(?:source|actor):github:[1-9][0-9]*|(?:project|resource|collection|relation|claim):[a-z0-9][a-z0-9._-]{0,127})$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "status": {
          "type": "string",
          "enum": [
            "candidate",
            "listed"
          ]
        },
        "updated_at": {
          "type": "string",
          "format": "utc-date-time"
        },
        "provenance": {
          "$ref": "#/$defs/provenance_map"
        },
        "catalog_dates": {
          "$ref": "#/$defs/catalog_dates"
        },
        "kind": {
          "const": "project"
        },
        "classification": {
          "type": "object",
          "properties": {
            "scheme": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "codes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "minItems": 0,
              "maxItems": 100,
              "uniqueItems": true
            },
            "unclassified_reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "required": [
            "scheme",
            "version",
            "codes"
          ],
          "additionalProperties": true
        },
        "research_tags": {
          "type": "object",
          "properties": {
            "scheme": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "minItems": 0,
              "maxItems": 100,
              "uniqueItems": true
            }
          },
          "required": [
            "scheme",
            "version",
            "ids"
          ],
          "additionalProperties": true
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "minItems": 0,
          "maxItems": 100000
        },
        "source_refs": {
          "type": "array",
