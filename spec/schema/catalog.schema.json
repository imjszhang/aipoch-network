        },
        "provenance": {
          "$ref": "#/$defs/provenance_map"
        },
        "kind": {
          "const": "project"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
