        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "status": {
          "type": "string",
          "enum": [
            "candidate",
            "listed"
          ]
        },
        "updated_at": {
          "type": "string",
          "format": "utc-date-time"
        },
        "provenance": {
          "$ref": "#/$defs/provenance_map"
        },
        "kind": {
          "const": "resource"
        },
        "resource_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "minItems": 0,
          "maxItems": 100000
        },
        "source_refs": {
          "type": "array",
